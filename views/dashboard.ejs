<div class="container">
    <div class="page-header">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back, <%= user.display_name %>
        </p>
    </div>

    <div class="dashboard-grid">
        <div class="stat-card">
            <div class="stat-title">Account Type</div>
            <div class="stat-value">
                <%= user.account_type.toUpperCase() %>
            </div>
            <p>Your current access level</p>
        </div>

        <div class="stat-card">
            <div class="stat-title">Username</div>
            <div class="stat-value">@<%= user.username %>
            </div>
            <p>Your unique identifier</p>
        </div>

        <div class="stat-card">
            <div class="stat-title">Quick Actions</div>
            <div class="stat-value">⚡</div>
            <div class="flex flex-col gap-2 mt-3">
                <a href="/profile" class="btn btn-sm btn-outline">Edit Profile</a>
                <a href="/settings" class="btn btn-sm btn-outline">Settings</a>
                <% if (user.account_type==='admin' ) { %>
                    <a href="/admin" class="btn btn-sm btn-primary">Admin Panel</a>
                    <% } %>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">System Status</h2>
        </div>
        <div class="card-content">
            <div class="flex justify-between items-center mb-3">
                <span>Database Connection</span>
                <span class="stat-change positive">✓ Connected</span>
            </div>
            <div class="flex justify-between items-center mb-3">
                <span>Session Status</span>
                <span class="stat-change positive">✓ Active</span>
            </div>
            <div class="flex justify-between items-center">
                <span>Security</span>
                <span class="stat-change positive">✓ Secure</span>
            </div>
        </div>
    </div>
</div>