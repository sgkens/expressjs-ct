<div class="container-sm">
    <div class="page-header">
        <h1 class="page-title">Profile Settings</h1>
        <p class="page-subtitle">Manage your account information</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Account Information</h2>
        </div>
        <div class="card-content">
            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
                <% } %>

                    <% if (success) { %>
                        <div class="alert alert-success">
                            <%= success %>
                        </div>
                        <% } %>

                            <form action="/profile" method="POST">
                                <div class="form-group">
                                    <label for="username" class="form-label">Username</label>
                                    <input type="text" id="username" name="username" class="form-input"
                                        value="<%= user.username %>" disabled readonly>
                                    <small class="text-muted">Username cannot be changed</small>
                                </div>

                                <div class="form-group">
                                    <label for="display_name" class="form-label">Display Name</label>
                                    <input type="text" id="display_name" name="display_name" class="form-input"
                                        value="<%= user.display_name %>" required>
                                </div>

                                <div class="form-group">
                                    <label for="account_type" class="form-label">Account Type</label>
                                    <input type="text" id="account_type" name="account_type" class="form-input"
                                        value="<%= user.account_type %>" disabled readonly>
                                    <small class="text-muted">Contact an administrator to change account type</small>
                                </div>

                                <hr style="margin: 2rem 0; border: none; border-top: 1px solid var(--border-color);">

                                <h3 class="mb-3">Change Password</h3>
                                <p class="text-muted mb-4">Leave password fields blank to keep current password</p>

                                <div class="form-group">
                                    <label for="current_password" class="form-label">Current Password</label>
                                    <input type="password" id="current_password" name="current_password"
                                        class="form-input" placeholder="Enter current password"
                                        autocomplete="current-password">
                                </div>

                                <div class="form-group">
                                    <label for="new_password" class="form-label">New Password</label>
                                    <input type="password" id="new_password" name="new_password" class="form-input"
                                        placeholder="Enter new password" minlength="6" autocomplete="new-password">
                                </div>

                                <div class="form-group">
                                    <label for="confirm_password" class="form-label">Confirm New Password</label>
                                    <input type="password" id="confirm_password" name="confirm_password"
                                        class="form-input" placeholder="Confirm new password"
                                        autocomplete="new-password">
                                </div>

                                <button type="submit" class="btn btn-primary w-full">Update Profile</button>
                            </form>
        </div>
    </div>
</div>